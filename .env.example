# Healthcare Analytics & MLOps Environment Configuration

# Database Configuration (PostgreSQL default, falls back to SQLite/DuckDB if unavailable)
DB_TYPE=sqlite
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_db
DB_CONNECTION_STRING=sqlite:///data/analytics/healthcare_mart.db

# Ingestion Settings
DATA_SOURCE_URL=https://archive.ics.uci.edu/static/public/296/diabetes+130-us+hospitals+for+years+1999-2008.zip
RAW_DATA_DIR=data/raw
STAGING_DATA_DIR=data/staging
CURATED_DATA_DIR=data/curated
REJECTED_DATA_DIR=data/rejected

# MLflow Settings
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=hospital-readmission-prediction

# API & Serving Settings
API_HOST=0.0.0.0
API_PORT=8000
